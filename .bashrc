# ==========================================
# 1. エイリアス設定 (よく使うコマンドの短縮)
# ==========================================
alias ..='cd ..'                # 1つ上の階層に移動
alias ...='cd ../..'            # 2つ上の階層に移動
alias ll='ls -alF'              # 詳細な一覧表示（隠しファイル含む）
alias la='ls -A'                # 隠しファイルを含めて一覧表示
alias grep='grep --color=auto'  # 検索結果に色を付ける
alias mkdir='mkdir -p'          # 親ディレクトリも同時に自動作成

# 安全対策（実行前に確認を求める）
alias rm='rm -i'
alias cp='cp -i'
alias mv='mv -i'


# ==========================================
# 2. 環境変数の設定 (システムやアプリの挙動変更)
# ==========================================
# コマンド履歴のカスタマイズ
export HISTSIZE=10000           # メモリ上に保存する履歴数
export HISTFILESIZE=20000       # ファイルに保存する履歴数
export HISTCONTROL=ignoredups   # 重複する古いコマンドを履歴に残さない

# デフォルトのエディタをVS Codeに変更 (nano や vim 等への変更も可能)
export EDITOR='code --wait'

# 自作スクリプト用フォルダへのパスを通す
export PATH=$PATH:$HOME/bin:$HOME/.local/bin


# ==========================================
# 3. プロンプト（入力待ち画面）の見た目変更
# ==========================================
# ［ユーザー名@ホスト名 ディレクトリ］を表示（緑色でスタイリッシュに）
PS1='\[\033[01;32m\]\u@\h\[\033[00m\]:\[\033[01;34m\]\w\[\033[00m\]\$ '


# ==========================================
# 4. 便利な関数（引数を受け取る高度な設定）
# ==========================================
# 「mkdcd ディレクトリ名」で、作成と同時にその中へ移動する
mkdcd() {
    mkdir -p "$1" && cd "$1"
}
eval "$(starship init bash)"
